<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="inventory_shopping_cart.PriceAuthReview">
        <div class="pa-review" t-if="state.data">

            <!-- ═══════ HERO ═══════ -->
            <div class="pa-hero" t-att-class="'pa-hero--' + d.state">
                <div class="pa-hero-main">
                    <div class="pa-hero-eyebrow">Autorización de precio · <t t-esc="d.operation_label"/></div>
                    <div class="pa-hero-title" t-esc="d.name"/>
                    <div class="pa-hero-chips">
                        <span class="pa-chip" t-if="d.partner">
                            <i class="fa fa-user"/> <t t-esc="d.partner"/>
                        </span>
                        <span class="pa-chip" t-if="d.project">
                            <i class="fa fa-folder-open-o"/> <t t-esc="d.project"/>
                        </span>
                        <span class="pa-chip">
                            <i class="fa fa-id-badge"/> Vendedor: <strong t-esc="d.seller"/>
                        </span>
                        <span class="pa-chip" t-if="d.create_date">
                            <i class="fa fa-clock-o"/> <t t-esc="d.create_date"/>
                        </span>
                    </div>
                </div>
                <div class="pa-hero-side">
                    <span class="pa-state" t-att-class="'pa-state--' + d.state" t-esc="d.state_label"/>
                    <div class="pa-hero-total">
                        <span class="pa-hero-total-label">Total de la operación</span>
                        <span class="pa-hero-total-value">
                            <t t-esc="money(d.totals.authorized)"/>
                            <small t-esc="d.currency"/>
                        </span>
                        <span class="pa-hero-total-sub">
                            <t t-esc="num(d.totals.qty)"/> m² en <t t-esc="d.lines.length"/> producto(s)
                        </span>
                    </div>
                </div>
            </div>

            <!-- ═══════ AVISO ORDEN GENERADA ═══════ -->
            <div class="pa-order-ok" t-if="d.sale_order">
                <i class="fa fa-check-circle"/>
                Orden generada: <strong t-esc="d.sale_order"/>
            </div>

            <!-- ═══════ PRODUCTOS ═══════ -->
            <div class="pa-cards">
                <t t-foreach="d.lines" t-as="line" t-key="line.id">
                    <div class="pa-card" t-att-class="'pa-card--' + levelTone(line)">
                        <div class="pa-card-head">
                            <div class="pa-card-product" t-esc="line.product"/>
                            <span class="pa-level-tag" t-att-class="'pa-level-tag--' + levelTone(line)"
                                  t-if="d.is_authorizer" t-esc="levelLabel(line)"/>
                        </div>

                        <div class="pa-card-qty">
                            <t t-esc="num(line.quantity)"/> <small t-esc="line.uom"/>
                        </div>

                        <!-- Los 3 niveles: solo autorizador -->
                        <div class="pa-levels" t-if="d.is_authorizer">
                            <div class="pa-level">
                                <span class="pa-level-name">Precio 1</span>
                                <span class="pa-level-value" t-esc="money(line.price_1)"/>
                            </div>
                            <div class="pa-level">
                                <span class="pa-level-name">Precio 2</span>
                                <span class="pa-level-value" t-esc="money(line.price_2)"/>
                            </div>
                            <div class="pa-level">
                                <span class="pa-level-name">Precio 3</span>
                                <span class="pa-level-value" t-esc="money(line.price_3)"/>
                            </div>
                        </div>

                        <div class="pa-card-prices">
                            <div class="pa-price">
                                <span class="pa-price-label">Prometido al cliente</span>
                                <span class="pa-price-value" t-att-class="'pa-price-value--' + levelTone(line)"
                                      t-esc="money(line.requested_price)"/>
                            </div>
                            <div class="pa-price" t-if="d.is_authorizer">
                                <span class="pa-price-label">Autorizado</span>
                                <input t-if="d.can_authorize"
                                       type="number" step="0.01" min="0"
                                       class="pa-price-input"
                                       t-att-value="line.authorized_price || line.requested_price"
                                       t-on-change="(ev) => this.onPriceChange(line, ev)"/>
                                <span t-else="" class="pa-price-value"
                                      t-esc="money(line.authorized_price || line.requested_price)"/>
                            </div>
                        </div>

                        <div class="pa-card-foot">
                            <span class="pa-cost" t-if="d.is_authorizer and line.cost">
                                Costo destino: <t t-esc="money(line.cost)"/>
                            </span>
                            <span class="pa-subtotal">
                                Subtotal <strong t-esc="money(line.subtotal)"/>
                            </span>
                        </div>
                    </div>
                </t>
            </div>

            <!-- ═══════ NOTAS DEL VENDEDOR ═══════ -->
            <div class="pa-notes" t-if="d.notes">
                <i class="fa fa-comment-o"/>
                <div>
                    <strong>Nota del vendedor</strong>
                    <p t-esc="d.notes"/>
                </div>
            </div>

            <!-- ═══════ BARRA DE DECISIÓN ═══════ -->
            <div class="pa-actionbar" t-if="d.can_authorize">
                <div class="pa-actionbar-total">
                    <span>Total a autorizar</span>
                    <strong><t t-esc="money(d.totals.authorized)"/> <small t-esc="d.currency"/></strong>
                </div>
                <div class="pa-actionbar-btns">
                    <button class="pa-btn pa-btn--reject" t-att-disabled="state.busy"
                            t-on-click="reject">
                        <i class="fa fa-times"/> Rechazar
                    </button>
                    <button class="pa-btn pa-btn--approve" t-att-disabled="state.busy"
                            t-on-click="approve">
                        <i class="fa fa-check"/> Aprobar
                    </button>
                </div>
            </div>

            <!-- ═══════ RESOLUCIÓN (ya decidida) ═══════ -->
            <div class="pa-resolution" t-if="d.state !== 'pending' and d.authorizer">
                <i t-att-class="'fa ' + (d.state === 'approved' ? 'fa-check-circle' : 'fa-times-circle')"/>
                <span>
                    <t t-esc="d.state_label"/> por <strong t-esc="d.authorizer"/>
                    <t t-if="d.authorization_date"> · <t t-esc="d.authorization_date"/></t>
                </span>
            </div>
        </div>
        <div class="pa-review pa-review--loading" t-else="">
            <i class="fa fa-circle-o-notch fa-spin"/> Cargando solicitud…
        </div>
    </t>

</templates>
