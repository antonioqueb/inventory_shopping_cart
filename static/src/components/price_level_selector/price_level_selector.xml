<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="inventory_shopping_cart.PriceLevelSelectorField">
        <div class="o_price_level_selector">
            <span t-if="props.readonly"
                  class="o_price_level_selector__label"
                  t-esc="displayLabel || 'Sin precio seleccionado'"/>

            <!-- Personalizado: UN solo control. El input del monto ocupa el
                 lugar del selector; la etiqueta "PP" regresa a la lista de
                 niveles. -->
            <div t-elif="showInlinePrice and value === 'custom' and !ui.pickLevel"
                 class="o_price_level_selector__custom-wrap">
                <button type="button"
                        class="o_price_level_selector__custom-tag"
                        title="Cambiar nivel de precio"
                        t-on-click.stop="onReopenLevels">PP <i class="fa fa-caret-down"/></button>
                <span class="o_price_level_selector__custom-cur">$</span>
                <input type="number"
                       t-ref="priceInput"
                       step="0.01"
                       min="0"
                       class="o_input o_price_level_selector__custom"
                       placeholder="Monto"
                       t-att-value="priceValue || ''"
                       t-on-click.stop=""
                       t-on-keydown="onPriceKeydown"
                       t-on-change="onPriceChange"/>
            </div>

            <select t-else=""
                    t-ref="select"
                    class="o_input o_price_level_selector__select"
                    t-on-change.stop="onChange"
                    t-on-mousedown="onSelectOpen"
                    t-on-focus="onSelectOpen"
                    t-on-blur="onSelectClose"
                    t-att-required="props.required"
                    t-att-disabled="props.readonly">
                <option t-foreach="options"
                        t-as="opt"
                        t-key="opt[0]"
                        t-att-value="opt[0]"
                        t-att-selected="opt[0] === value ? 'selected' : undefined">
                    <t t-esc="opt[1]"/>
                </option>
            </select>
        </div>
    </t>

</templates>
