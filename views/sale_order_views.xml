<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_enhanced_prices" model="ir.ui.view">
        <field name="name">sale.order.form.enhanced.prices</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">130</field>
        <field name="arch" type="xml">

            <!-- ===================== BOTÓN SOLICITAR AUTORIZACIÓN ===================== -->
            <xpath expr="//header/button[@name='action_quotation_send']" position="after">
                <button name="action_request_authorization"
                        string="Solicitar Autorización de Precio"
                        type="object"
                        class="btn-warning"
                        invisible="state == 'cancel' or not x_has_low_prices"
                        groups="inventory_shopping_cart.group_seller"/>

                <!-- Autorización de DESCUENTOS altos. Cubre AMBOS casos:
                     aplicado sobre umbral (orden bloqueada) y RETENIDO
                     (x_discount_pending_request: capturado sin aplicar,
                     esperando autorización — patrón precios mínimos). -->
                <field name="x_discount_pending_request" invisible="1"/>
                <button name="action_request_discount_authorization"
                        string="Solicitar autorización de descuento"
                        type="object"
                        class="btn-warning"
                        invisible="state == 'cancel' or not x_discount_needs_auth or x_discount_auth_requested"
                        groups="inventory_shopping_cart.group_seller"/>
                <button name="action_authorize_discount"
                        string="Autorizar descuento"
                        type="object"
                        class="btn-success"
                        invisible="state == 'cancel' or (not x_discount_needs_auth and not x_discount_pending_request)"
                        groups="inventory_shopping_cart.group_price_authorizer"/>
                <button name="action_reject_discount"
                        string="Rechazar descuento"
                        type="object"
                        class="btn-secondary"
                        invisible="state == 'cancel' or (not x_discount_needs_auth and not x_discount_pending_request)"
                        groups="inventory_shopping_cart.group_price_authorizer"/>

                <!-- Exención de IVA: acción DIRECTA y exclusiva. Solo la ven
                     (y accionan) el Autorizador de Precios Mínimos y el Visor
                     del Dashboard (SOM Analytics) — el autorizador implica al
                     visor, por eso basta el grupo del visor. Los vendedores ya
                     no tienen flujo de solicitud. -->
                <field name="x_iva_exempt_state" invisible="1"/>
                <button name="action_remove_iva"
                        string="Eliminar IVA"
                        type="object"
                        class="btn-warning"
                        invisible="state == 'cancel' or x_iva_exempt_state == 'approved'"
                        groups="inventory_shopping_cart.group_dashboard_viewer"/>
                <!-- Solicitudes EN VUELO del flujo anterior: los autorizadores
                     aún pueden resolverlas; no se generan nuevas. -->
                <button name="action_approve_iva_exemption"
                        string="Aprobar quitar IVA"
                        type="object"
                        class="btn-success"
                        invisible="x_iva_exempt_state != 'requested'"
                        groups="inventory_shopping_cart.group_price_authorizer"/>
                <button name="action_reject_iva_exemption"
                        string="Rechazar quitar IVA"
                        type="object"
                        class="btn-secondary"
                        invisible="x_iva_exempt_state != 'requested'"
                        groups="inventory_shopping_cart.group_price_authorizer"/>
            </xpath>

            <!-- ===================== DIVISA EDITABLE HASTA LA ENTREGA ===================== -->
            <!-- La confirmación NO congela la divisa: la lista de precios se
                 puede cambiar (con remapeo de precios) mientras no haya
                 entrega validada ni factura publicada. -->
            <xpath expr="//field[@name='pricelist_id']" position="attributes">
                <attribute name="readonly">x_pricelist_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='pricelist_id']" position="before">
                <field name="x_pricelist_locked" invisible="1"/>
            </xpath>

            <!-- ===================== OCULTAR BOTONES CUANDO HAY PRECIOS BAJOS ===================== -->
            <xpath expr="//header/button[@name='action_quotation_send']" position="attributes">
                <attribute name="invisible">state not in ['draft', 'sent'] or x_has_low_prices or x_discount_needs_auth</attribute>
            </xpath>

            <xpath expr="//header/button[@name='action_confirm']" position="attributes">
                <attribute name="invisible">state != 'sent' or x_has_low_prices or x_discount_needs_auth</attribute>
            </xpath>

            <!-- El header trae DOS botones Confirmar (draft y sent); el xpath
                 anterior solo cubría el primero. -->
            <xpath expr="(//header/button[@name='action_confirm'])[2]" position="attributes">
                <attribute name="invisible">state != 'draft' or x_has_low_prices or x_discount_needs_auth</attribute>
            </xpath>

            <!-- ===================== BANNERS DE CONTROL DE PRECIO ===================== -->
            <xpath expr="//sheet" position="before">
                <field name="x_has_low_prices" invisible="1"/>

                <!-- Banner para vendedor -->
                <div
                    groups="inventory_shopping_cart.group_seller"
                    invisible="not x_has_low_prices or state == 'cancel'"
                    style="margin: 0 0 16px 0; border: 1px solid #f1b5b9; border-left: 6px solid #c62828; border-radius: 14px; background: linear-gradient(135deg, #fff8f8 0%, #fdecec 100%); box-shadow: 0 8px 24px rgba(198, 40, 40, 0.08); overflow: hidden;"
                >
                    <div style="padding: 16px 18px;">
                        <div style="display: flex; align-items: center; gap: 14px;">
                            <div
                                style="width: 52px; height: 52px; min-width: 52px; border-radius: 50%; background: #c62828; color: #ffffff; display: flex; align-items: center; justify-content: center; box-shadow: 0 6px 16px rgba(198, 40, 40, 0.18); font-size: 20px;"
                            >
                                <i class="fa fa-shield" title="Control de precios" role="img"/>
                            </div>

                            <div style="flex: 1;">
                                <div
                                    style="font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #b02a37; margin-bottom: 4px;"
                                >
                                    Control de precios
                                </div>

                                <div
                                    style="font-size: 20px; font-weight: 700; color: #7a1c24; line-height: 1.2; margin-bottom: 6px;"
                                >
                                    Orden bloqueada por precios no autorizados
                                </div>

                                <div
                                    style="font-size: 13px; color: #6c2b31; line-height: 1.55;"
                                >
                                    Esta orden contiene productos con precio por debajo del nivel medio permitido.
                                    No es posible <strong>enviar</strong>, <strong>imprimir</strong> ni <strong>confirmar</strong> la orden
                                    hasta que se gestione una autorización.
                                </div>
                                <div style="font-size: 13px; color: #7a1c24; margin-top: 8px; white-space: pre-line; font-weight: 600;">
                                    <field name="x_low_price_details" readonly="1" nolabel="1"/>
                                </div>
                            </div>
                        </div>

                        <div
                            style="margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(122, 28, 36, 0.10); font-size: 13px; color: #7a1c24;"
                        >
                            <strong>Acción requerida:</strong>
                            use el botón <strong>Solicitar Autorización de Precio</strong> para continuar.
                        </div>
                    </div>
                </div>

                <!-- Banner para autorizador -->
                <div
                    groups="inventory_shopping_cart.group_price_authorizer"
                    invisible="not x_has_low_prices or state == 'cancel'"
                    style="margin: 0 0 16px 0; border: 1px solid #ffe08a; border-left: 6px solid #d39e00; border-radius: 14px; background: linear-gradient(135deg, #fffdf6 0%, #fff7db 100%); box-shadow: 0 8px 24px rgba(211, 158, 0, 0.08); overflow: hidden;"
                >
                    <div style="padding: 14px 18px; display: flex; align-items: center; gap: 12px;">
                        <div
                            style="width: 42px; height: 42px; min-width: 42px; border-radius: 50%; background: #d39e00; color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 16px;"
                        >
                            <i class="fa fa-key" title="Autorización de precios" role="img"/>
                        </div>

                        <div style="flex: 1;">
                            <div
                                style="font-size: 15px; font-weight: 700; color: #7a5a00; margin-bottom: 3px;"
                            >
                                Precios por debajo del nivel medio detectados
                            </div>
                            <div
                                style="font-size: 13px; color: #6f5a1a; line-height: 1.5;"
                            >
                                Esta orden requiere revisión de precios. Como usuario autorizador, puede continuar con la operación sin restricción.
                            </div>
                            <div style="font-size: 13px; color: #6f5a1a; margin-top: 6px; white-space: pre-line; font-weight: 600;">
                                <field name="x_low_price_details" readonly="1" nolabel="1"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>

            <!-- ===================== BANNERS DE AUTORIZACIÓN DE DESCUENTO ===================== -->
            <xpath expr="//sheet" position="before">
                <field name="x_discount_needs_auth" invisible="1"/>
                <field name="x_discount_auth_requested" invisible="1"/>

                <!-- Vendedor: orden bloqueada por descuento -->
                <div groups="inventory_shopping_cart.group_seller"
                     invisible="not x_discount_needs_auth or state == 'cancel'"
                     style="margin: 0 0 16px 0; border: 1px solid #f1b5b9; border-left: 6px solid #c62828; border-radius: 14px; background: linear-gradient(135deg, #fff8f8 0%, #fdecec 100%); overflow: hidden;">
                    <div style="padding: 16px 18px;">
                        <div style="display:flex; align-items:center; gap:14px;">
                            <div style="width:52px;height:52px;min-width:52px;border-radius:50%;background:#c62828;color:#fff;display:flex;align-items:center;justify-content:center;font-size:20px;">
                                <i class="fa fa-percent" title="Descuento" role="img"/>
                            </div>
                            <div style="flex:1;">
                                <div style="font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#b02a37;margin-bottom:4px;">Autorización de descuento</div>
                                <div style="font-size:20px;font-weight:700;color:#7a1c24;line-height:1.2;margin-bottom:6px;">Orden bloqueada por descuento no autorizado</div>
                                <div style="font-size:13px;color:#6c2b31;line-height:1.55;">
                                    El descuento de esta orden (<strong><field name="x_discount_amount_mxn" readonly="1" class="oe_inline"/> MXN</strong>)
                                    supera el umbral permitido. No es posible <strong>enviar</strong>, <strong>confirmar</strong> ni
                                    <strong>facturar</strong> hasta que un autorizador lo apruebe.
                                </div>
                            </div>
                        </div>
                        <div style="margin-top:14px;padding-top:12px;border-top:1px solid rgba(122,28,36,0.10);font-size:13px;color:#7a1c24;">
                            <strong>Acción requerida:</strong> usa <strong>Solicitar autorización de descuento</strong>.
                        </div>
                    </div>
                </div>

                <!-- Autorizador -->
                <div groups="inventory_shopping_cart.group_price_authorizer"
                     invisible="not x_discount_needs_auth or state == 'cancel'"
                     style="margin: 0 0 16px 0; border: 1px solid #ffe08a; border-left: 6px solid #d39e00; border-radius: 14px; background: linear-gradient(135deg, #fffdf6 0%, #fff7db 100%); overflow: hidden;">
                    <div style="padding:14px 18px;display:flex;align-items:center;gap:12px;">
                        <div style="width:42px;height:42px;min-width:42px;border-radius:50%;background:#d39e00;color:#fff;display:flex;align-items:center;justify-content:center;font-size:16px;">
                            <i class="fa fa-key" title="Autorización" role="img"/>
                        </div>
                        <div style="flex:1;">
                            <div style="font-size:15px;font-weight:700;color:#7a5a00;margin-bottom:3px;">Descuento alto pendiente de autorización</div>
                            <div style="font-size:13px;color:#6f5a1a;line-height:1.5;">
                                Descuento de <strong><field name="x_discount_amount_mxn" readonly="1" class="oe_inline"/> MXN</strong>.
                                Usa <strong>Autorizar descuento</strong> para desbloquear, o <strong>Rechazar descuento</strong>.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>

            <!-- ===================== COLUMNA DERECHA (partner_details) ===================== -->
            <!-- Las direcciones de facturación/entrega YA NO viven aquí: cuando el
                 cliente no tiene direcciones específicas, ambas se rellenan con el
                 propio cliente y los vendedores las confundían con datos capturados.
                 Se movieron a la pestaña "Entrega y Facturación" (al final del
                 notebook). Siguen SIEMPRE llenas a nivel de datos: vaciarlas rompe
                 las reglas fiscales/de entrega de Odoo. -->
            <!-- Referencia + contacto del cliente ANTES de los vendedores:
                 esta vista aplica al último (priority 130), así que insertar
                 justo después de partner_id los deja ARRIBA de Vendedor 1/2
                 (que insertó sale_order_second_salesperson). Correo/Teléfono
                 son related EDITABLES sobre partner_id: capturar aquí un
                 correo que falta lo guarda en la ficha del cliente. -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="client_order_ref" string="Referencia"/>
                <field name="x_partner_email" string="Correo" widget="email"/>
                <field name="x_partner_phone" string="Teléfono" widget="phone"/>
            </xpath>

            <xpath expr="//group[@name='partner_details']" position="inside">
                <field name="x_project_id" string="Job Name / Proyecto"
                       domain="['|', ('partner_id', '=', False), ('partner_id', 'child_of', partner_id)]"
                       context="{'default_partner_id': partner_id}"/>

                <field name="x_architect_id"
                       string="Embajador"
                       domain="[('x_es_arquitecto', '=', True)]"/>
            </xpath>

            <!-- La Referencia original de "Otra información" se retira: ahora
                 vive en la parte superior del formulario. -->
            <xpath expr="//page[@name='other_information']//field[@name='client_order_ref']" position="replace"/>

            <!-- ============ PESTAÑA: ENTREGA Y FACTURACIÓN (direcciones) ============ -->
            <xpath expr="//notebook" position="inside">
                <page string="Entrega y Facturación" name="som_addresses">
                    <div class="alert alert-info" role="alert" style="margin-bottom: 12px;">
                        Estas direcciones se llenan por defecto con el cliente.
                        Antes de entregar, confirma aquí la <strong>dirección de entrega</strong>
                        real del material (y la de facturación si es distinta).
                    </div>
                    <group>
                        <group string="Facturación">
                            <!-- form_view_ref: el diálogo de crear/editar usa la
                                 vista COMPACTA de direcciones (sin pestañas). -->
                            <field name="partner_invoice_id"
                                   string="Dirección de Facturación"
                                   required="0"
                                   context="{'default_parent_id': partner_id, 'default_type': 'invoice', 'show_address': 1, 'form_view_ref': 'inventory_shopping_cart.view_partner_som_address_simple_form'}"
                                   options='{"always_reload": True, "no_create": False}'
                                   domain="['|', '&amp;', ('parent_id', '=', partner_id), ('type', '=', 'invoice'), ('id', '=', partner_id)]"/>
                        </group>
                        <group string="Entrega">
                            <field name="partner_shipping_id"
                                   string="Dirección de Entrega"
                                   required="0"
                                   context="{'default_parent_id': partner_id, 'default_type': 'delivery', 'show_address': 1, 'form_view_ref': 'inventory_shopping_cart.view_partner_som_address_simple_form'}"
                                   options='{"always_reload": True, "no_create": False}'
                                   domain="['|', '&amp;', ('parent_id', '=', partner_id), ('type', '=', 'delivery'), ('id', '=', partner_id)]"/>
                        </group>
                    </group>
                </page>
            </xpath>

            <!-- ===================== COLUMNA IZQUIERDA (order_details) ===================== -->
            <xpath expr="//group[@name='order_details']/field[@name='payment_term_id']" position="after">
                <field name="x_price_authorization_id"
                       string="Autorización de Precio"
                       readonly="1"
                       invisible="not x_price_authorization_id"/>

                <field name="x_is_usd" invisible="1"/>

                <field name="x_exchange_rate_source"
                       string="Fuente TC"
                       invisible="not x_is_usd"/>

                <field name="x_exchange_rate"
                       string="Tipo de Cambio MXN/USD"
                       readonly="1"
                       invisible="not x_is_usd"/>
            </xpath>

            <!-- ===================== ORDER LINES: PRICE SELECTOR ===================== -->
            <!-- COLUMNA ÚNICA DE PRECIO: el selector de nivel absorbe también
                 la captura del precio Personalizado (inline_price) y la
                 columna de precio unitario se oculta — un solo campo para
                 elegir N1..N5 o teclear el personalizado ahí mismo. -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="x_price_selector"
                       widget="price_level_selector"
                       options="{'inline_price': True}"
                       string="Precio"
                       style="width: 240px;"
                       required="1"/>

                <field name="x_price_1_value" column_invisible="1"/>
                <field name="x_price_2_value" column_invisible="1"/>
                <field name="x_price_3_value" column_invisible="1"/>
                <field name="x_price_4_value" column_invisible="1"/>
                <field name="x_price_5_value" column_invisible="1"/>
                <field name="x_price_level_currency" column_invisible="1"/>
                <field name="x_can_use_custom_price" column_invisible="1"/>
                <field name="x_can_use_minimum_price" column_invisible="1"/>
                <field name="x_can_use_level_4_price" column_invisible="1"/>
                <field name="x_can_use_level_5_price" column_invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/list//field[@name='price_unit']" position="attributes">
                <attribute name="readonly">x_price_selector != 'custom'</attribute>
                <attribute name="force_save">1</attribute>
                <!-- El precio vive ahora DENTRO del selector: la columna
                     propia se oculta (el campo permanece para datos/guardado). -->
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <!-- ===================== DESCUENTO POR LÍNEA ===================== -->
            <!-- Columna de descuento OCULTA pero disponible (opcionales de la
                 lista). Un descuento que dispara autorización NO se aplica:
                 queda en 'Desc. solicitado' hasta que un Autorizador de
                 Precios lo apruebe (mismo patrón que precios mínimos). El
                 grupo negado evita duplicar la columna nativa si algún día se
                 activa la opción de descuentos de Ventas. -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="discount" optional="hide"
                       groups="!sale.group_discount_per_so_line"/>
                <field name="x_requested_discount" optional="hide"/>
            </xpath>

        </field>
    </record>

    <!-- ============================================================
         Vista MÍNIMA de dirección (crear/editar desde la OV):
         SOLO el formulario principal — sin notebook ni pestañas de la
         ficha completa del contacto (propia del módulo: ningún inherit
         de terceros puede meterle pestañas).
         ============================================================ -->
    <record id="view_partner_som_address_simple_form" model="ir.ui.view">
        <field name="name">res.partner.som.address.simple.form</field>
        <field name="model">res.partner</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Dirección">
                <sheet>
                    <group>
                        <group string="Contacto">
                            <field name="type" invisible="1"/>
                            <field name="parent_id" invisible="1"/>
                            <field name="name" string="Nombre / Referencia" required="1"/>
                            <!-- Odoo 19 eliminó 'mobile' de res.partner (unificado en phone) -->
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                        <group string="Dirección">
                            <label for="street" string="Dirección"/>
                            <div class="o_address_format">
                                <field name="street" placeholder="Calle y número..." class="o_address_street"/>
                                <field name="street2" placeholder="Colonia / interior..." class="o_address_street"/>
                                <field name="city" placeholder="Ciudad" class="o_address_city"/>
                                <field name="state_id" class="o_address_state" placeholder="Estado"
                                       options="{'no_open': True, 'no_quick_create': True}"/>
                                <field name="zip" placeholder="C.P." class="o_address_zip"/>
                                <field name="country_id" placeholder="País" class="o_address_country"
                                       options="{'no_open': True, 'no_quick_create': True}"/>
                            </div>
                        </group>
                    </group>
                    <group>
                        <field name="comment" string="Notas de entrega" nolabel="1"
                               placeholder="Referencias del lugar, horarios, indicaciones para el chofer..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================
         Vista Tree: Órdenes de Venta - Columna Job Name/Proyecto
         ============================================================ -->
    <record id="view_order_tree_project_column" model="ir.ui.view">
        <field name="name">sale.order.tree.project.column</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <!-- Referencia del cliente como PRIMERA columna, antes del folio -->
            <field name="name" position="before">
                <field name="client_order_ref" string="Referencia" optional="show"/>
            </field>
            <field name="partner_id" position="after">
                <field name="x_project_id" string="Job Name/Proyecto" optional="show"/>
            </field>
        </field>
    </record>

    <!-- ============================================================
         Vista Tree: Presupuestos - Columna Job Name/Proyecto
         ============================================================ -->
    <record id="view_quotation_tree_project_column" model="ir.ui.view">
        <field name="name">sale.order.quotation.tree.project.column</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <!-- Referencia del cliente como PRIMERA columna, antes del folio -->
            <field name="name" position="before">
                <field name="client_order_ref" string="Referencia" optional="show"/>
            </field>
            <field name="partner_id" position="after">
                <field name="x_project_id" string="Job Name/Proyecto" optional="show"/>
            </field>
        </field>
    </record>

</odoo>