<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_custom_prices" model="ir.ui.view">
        <field name="name">product.template.form.custom.prices</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="before">
                <field name="x_name_sps"/>
            </xpath>

            <xpath expr="//page[@name='sales']" position="after">
                <page string="Precios y Costos All-In" name="custom_prices"
                      groups="inventory_shopping_cart.group_price_authorizer,inventory_shopping_cart.group_seller">

                    <!-- ============================================================
                         SECCIÓN SOLO AUTORIZADORES: Logística, Costos, Estrategia
                         ============================================================ -->

                    <!-- PANEL DE CONFIGURACIÓN LOGÍSTICA -->
                    <group string="Configuración Logística y Arancelaria"
                           groups="inventory_shopping_cart.group_price_authorizer">
                        <group>
                            <field name="x_freight_mode" widget="radio" options="{'horizontal': true}"/>
                            <field name="x_national_route_id"
                                   invisible="x_freight_mode != 'national'"
                                   required="x_freight_mode == 'national'"
                                   options="{'no_create': True}"/>
                            <field name="x_origin_country_id" invisible="x_freight_mode == 'national'"/>
                            <field name="x_pol_id" options="{'no_create': True}" invisible="x_freight_mode == 'national'"/>
                            <field name="x_pod_id" options="{'no_create': True}" invisible="x_freight_mode == 'national'"/>
                            <field name="x_naviera_id"
                                   domain="[('category_id.name', '=', 'Naviera')]"
                                   options="{'no_create': True}"/>
                            <field name="x_forwarder_id"
                                   domain="[('category_id.name', '=', 'Forwarder')]"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="x_container_capacity"/>
                            <field name="x_arancel_pct" invisible="x_freight_mode == 'national'"/>
                            <button name="action_update_costs"
                                    string="Recalcular Costos Ahora"
                                    type="object"
                                    class="btn-link"
                                    icon="fa-refresh"/>
                        </group>
                    </group>

                    <!-- TIPO DE CAMBIO USADO -->
                    <group string="Tipo de Cambio Usado para Costeo"
                           groups="inventory_shopping_cart.group_price_authorizer">
                        <group>
                            <field name="x_cost_eur_usd_rate"/>
                            <field name="x_cost_eur_usd_source"/>
                            <field name="x_cost_exchange_rate"
                                   string="TC usado USD → MXN"
                                   readonly="1"/>
                            <field name="x_cost_exchange_rate_source"
                                   string="Fuente"
                                   readonly="1"/>
                        </group>
                        <group>
                            <field name="x_cost_exchange_rate_last_sync"
                                   string="Última sincronización"
                                   readonly="1"/>
                            <field name="x_freight_tariff_all_in_usd"
                                   string="Tarifa All-In Contenedor USD"
                                   readonly="1"/>
                        </group>
                    </group>

                    <!-- DESGLOSE DE COSTOS EN AMBAS DIVISAS -->
                    <group groups="inventory_shopping_cart.group_price_authorizer">

                        <!-- MXN -->
                        <group string="Desglose del Costo (MXN)">
                            <field name="x_has_purchases" invisible="1"/>

                            <label for="x_cost_base_mxn" string="1. Costo Base Usado"/>
                            <div class="o_row">
                                <field name="x_cost_base_mxn" readonly="1"/>
                                <span class="text-muted" invisible="x_has_purchases">(Costo Estándar)</span>
                                <span class="text-success fw-bold" invisible="not x_has_purchases">(MaxAvg Histórico)</span>
                            </div>

                            <field name="x_max_avg_cost_mxn"
                                   string="MaxAvg Histórico MXN"
                                   readonly="1"
                                   invisible="not x_has_purchases"/>

                            <field name="x_logistics_cost_mxn"
                                   string="2. + Logística MXN x m²"
                                   readonly="1"/>

                            <field name="x_duty_cost_mxn"
                                   string="3. + Arancel MXN"
                                   readonly="1"/>

                            <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                <label for="x_costo_mayor"/>
                            </div>
                            <field name="x_costo_mayor"
                                   nolabel="1"
                                   readonly="1"
                                   class="oe_subtotal_footer_separator"
                                   widget="monetary"/>
                        </group>

                        <!-- USD -->
                        <group string="Desglose del Costo (USD)">
                            <field name="x_cost_base_usd"
                                   string="1. Costo Base USD"
                                   readonly="1"/>

                            <field name="x_logistics_cost_usd"
                                   string="2. + Logística USD x m²"
                                   readonly="1"/>

                            <field name="x_duty_cost_usd"
                                   string="3. + Arancel USD"
                                   readonly="1"/>

                            <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                <label for="x_costo_mayor_usd"/>
                            </div>
                            <field name="x_costo_mayor_usd"
                                   nolabel="1"
                                   readonly="1"
                                   class="oe_subtotal_footer_separator"/>
                        </group>
                    </group>

                    <!-- RESUMEN DE CÁLCULO -->
                    <group string="Detalle del Cálculo"
                           groups="inventory_shopping_cart.group_price_authorizer">
                        <group>
                            <field name="x_logistics_calc_summary"
                                   string="Fórmula Logística"
                                   readonly="1"/>
                        </group>
                        <group>
                            <field name="x_cost_calc_summary"
                                   string="Resumen ALL-IN"
                                   readonly="1"/>
                        </group>
                    </group>

                    <!-- ESTRATEGIA DE PRECIOS -->
                    <group groups="inventory_shopping_cart.group_price_authorizer">
                        <group string="Estrategia de Precios">
                            <field name="x_pricing_mode" widget="radio"/>

                            <field name="x_fixed_price"
                                   invisible="x_pricing_mode != 'fixed'"
                                   widget="monetary"/>

                            <separator string="Niveles de Utilidad"/>

                            <!-- Escalera ordenada: la utilidad (margen
                                 sobre el PRECIO) es la que MANDA y se
                                 captura a la izquierda; el markup sobre
                                 costo es SOLO LECTURA de referencia a la
                                 derecha. Restringida a [0%, 100%). -->
                            <div colspan="2" class="mt-2">
                                <table class="table table-sm o_main_table" style="max-width: 560px;">
                                    <thead>
                                        <tr>
                                            <th style="width: 40%;">Nivel</th>
                                            <th class="text-end" style="width: 30%;">% Utilidad (s/precio)</th>
                                            <th class="text-end text-muted" style="width: 30%;">Markup s/costo</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td class="fw-bold">1 · Alta</td>
                                            <td class="text-end"><field name="x_utilidad" nolabel="1" class="oe_inline"/> %</td>
                                            <td class="text-end text-muted"><field name="x_markup_1" nolabel="1" readonly="1" class="oe_inline"/> %</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold">2 · Media</td>
                                            <td class="text-end"><field name="x_utilidad_media" nolabel="1" class="oe_inline"/> %</td>
                                            <td class="text-end text-muted"><field name="x_markup_2" nolabel="1" readonly="1" class="oe_inline"/> %</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold">3 · Nivel 3</td>
                                            <td class="text-end"><field name="x_utilidad_minima" nolabel="1" class="oe_inline"/> %</td>
                                            <td class="text-end text-muted"><field name="x_markup_3" nolabel="1" readonly="1" class="oe_inline"/> %</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold">4 · Nivel 4</td>
                                            <td class="text-end"><field name="x_utilidad_4" nolabel="1" class="oe_inline"/> %</td>
                                            <td class="text-end text-muted"><field name="x_markup_4" nolabel="1" readonly="1" class="oe_inline"/> %</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold">5 · Mínima</td>
                                            <td class="text-end"><field name="x_utilidad_5" nolabel="1" class="oe_inline"/> %</td>
                                            <td class="text-end text-muted"><field name="x_markup_5" nolabel="1" readonly="1" class="oe_inline"/> %</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <div class="alert alert-info mt-2" role="alert" colspan="2">
                                <small>
                                    <strong>Modo Calculado:</strong> Precio = Costo ÷ (1 − %Utilidad). La utilidad es sobre el PRECIO de venta y debe ser menor a 100%.<br/>
                                    <strong>Modo Fijo:</strong> misma fórmula con el Precio Fijo como base.<br/>
                                    <strong>Markup s/costo:</strong> referencia informativa = Utilidad ÷ (100 − Utilidad); utilidad 40% ≡ markup 66.7%.<br/>
                                    <strong>Visibilidad:</strong> Vendedor regular ve Nivel 1 y 2. Vendedor mayorista y Autorizador ven Niveles 1 a 5.
                                </small>
                            </div>
                        </group>

                        <group string="Notas de Costeo">
                            <div class="alert alert-warning" role="alert" colspan="2">
                                <small>
                                    <strong>Logística:</strong> Tarifa All-In USD / Capacidad del contenedor = USD x m².<br/>
                                    <strong>Conversión:</strong> USD x m² × TC Banorte venta = MXN x m².<br/>
                                    <strong>ALL-IN:</strong> Costo Base + Logística + Arancel.
                                </small>
                            </div>
                        </group>
                    </group>

                    <!-- ============================================================
                         ESCALERA DE PRECIOS
                         - Vendedor regular: solo Precio 1 y Precio 2
                         - Vendedor mayorista: Precios 1 a 5
                         - Autorizador: Precios 1 a 5
                         ============================================================ -->
                    <group>
                        <group string="Escalera MXN">
                            <field name="x_price_mxn_1"
                                   readonly="1"
                                   force_save="1"
                                   string="1. Precio Alto"/>
                            <field name="x_price_mxn_2"
                                   readonly="1"
                                   force_save="1"
                                   string="2. Precio Medio"/>
                            <field name="x_price_mxn_3"
                                   readonly="1"
                                   force_save="1"
                                   string="3. Precio Nivel 3"
                                   groups="inventory_shopping_cart.group_seller_mayorista,inventory_shopping_cart.group_price_authorizer"/>
                            <field name="x_price_mxn_4"
                                   readonly="1"
                                   force_save="1"
                                   string="4. Precio Nivel 4"
                                   groups="inventory_shopping_cart.group_seller_mayorista,inventory_shopping_cart.group_price_authorizer"/>
                            <field name="x_price_mxn_5"
                                   readonly="1"
                                   force_save="1"
                                   string="5. Precio Mínimo"
                                   groups="inventory_shopping_cart.group_seller_mayorista,inventory_shopping_cart.group_price_authorizer"/>
                        </group>

                        <group string="Escalera USD">
                            <field name="x_price_usd_1"
                                   readonly="1"
                                   force_save="1"
                                   string="1. Precio Alto"/>
                            <field name="x_price_usd_2"
                                   readonly="1"
                                   force_save="1"
                                   string="2. Precio Medio"/>
                            <field name="x_price_usd_3"
                                   readonly="1"
                                   force_save="1"
                                   string="3. Precio Nivel 3"
                                   groups="inventory_shopping_cart.group_seller_mayorista,inventory_shopping_cart.group_price_authorizer"/>
                            <field name="x_price_usd_4"
                                   readonly="1"
                                   force_save="1"
                                   string="4. Precio Nivel 4"
                                   groups="inventory_shopping_cart.group_seller_mayorista,inventory_shopping_cart.group_price_authorizer"/>
                            <field name="x_price_usd_5"
                                   readonly="1"
                                   force_save="1"
                                   string="5. Precio Mínimo"
                                   groups="inventory_shopping_cart.group_seller_mayorista,inventory_shopping_cart.group_price_authorizer"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- LISTA DE PRODUCTOS (Inventario): columnas de costo/utilidad SOLO
         para el grupo "Ver Costo de Productos" (Odoo 19 eliminó groups_id
         en ir.ui.view → el gate va por CAMPO con groups=...). -->
    <record id="view_product_template_list_som_costs" model="ir.ui.view">
        <field name="name">product.template.list.som.costs</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <!-- multi_edit: click normal ABRE el producto (como siempre);
                 marcando el checkbox de la fila, las celdas se editan en
                 línea — costo, precios y las demás. -->
            <xpath expr="//list" position="attributes">
                <attribute name="multi_edit">1</attribute>
            </xpath>
            <xpath expr="//list" position="inside">
                <field name="x_costo_usd_edit" optional="show" groups="product_cost_security.group_product_cost_viewer"/>
                <field name="x_costo_mxn_edit" optional="hide" groups="product_cost_security.group_product_cost_viewer"/>
                <field name="x_price_usd_1" string="Precio 1" optional="show" groups="product_cost_security.group_product_cost_viewer"/>
                <field name="x_price_usd_2" string="Precio 2" optional="show" groups="product_cost_security.group_product_cost_viewer"/>
                <field name="x_price_usd_3" string="Precio 3" optional="show" groups="product_cost_security.group_product_cost_viewer"/>
                <field name="x_utilidad" string="Util. 1 %" optional="show" groups="product_cost_security.group_product_cost_viewer"/>
                <field name="x_utilidad_media" string="Util. 2 %" optional="show" groups="product_cost_security.group_product_cost_viewer"/>
                <field name="x_utilidad_minima" string="Util. 3 %" optional="show" groups="product_cost_security.group_product_cost_viewer"/>
                <field name="x_utilidad_4" string="Util. 4 %" optional="hide" groups="product_cost_security.group_product_cost_viewer"/>
                <field name="x_utilidad_5" string="Util. 5 %" optional="hide" groups="product_cost_security.group_product_cost_viewer"/>
            </xpath>
        </field>
    </record>

    <!-- MESA DE COSTOS Y PRECIOS — DEFINITIVA: lista de captura pura.
         JAMÁS abre el formulario (view_mode solo list + editable): click
         en cualquier celda = editar ahí mismo. La ESTRELLA (favorito) es
         la marca de "este producto ya quedó bien". Menú visible solo para
         el grupo Ver Costo de Productos. -->
    <record id="view_product_template_list_som_cost_editor" model="ir.ui.view">
        <field name="name">product.template.list.som.cost.editor</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list editable="top" create="0" delete="0"
                  default_order="x_cost_reviewed desc, name">
                <!-- Estrella nativa de Odoo, columna angosta y sin texto -->
                <field name="x_cost_reviewed" widget="boolean_favorite" string="★" nolabel="1"/>
                <field name="name" readonly="1"/>
                <field name="categ_id" optional="hide" readonly="1"/>
                <!-- Vaivén: editar cualquiera de los dos llena el otro con
                     el TC Banorte de costeo (inverse del motor). El MXN es el
                     costo nativo ALMACENADO: por él se ordena la lista
                     (clic en el encabezado, asc/desc); el USD es cálculo al
                     vuelo y comparte el mismo orden. -->
                <field name="x_costo_usd_edit" string="Costo USD"/>
                <field name="standard_price" string="Costo MXN" optional="show"/>
                <field name="x_costo_mxn_edit" column_invisible="1"/>
                <field name="x_costo_mayor_usd" string="All-In USD" readonly="1" optional="show"/>
                <field name="x_costo_mayor" string="All-In MXN" readonly="1" optional="hide"/>
                <field name="x_is_fixed_price" string="Fijo"/>
                <field name="x_fixed_price" string="Precio fijo MXN"
                       readonly="not x_is_fixed_price" optional="show"/>
                <field name="x_utilidad" string="Util. 1 %"/>
                <field name="x_utilidad_media" string="Util. 2 %"/>
                <field name="x_utilidad_minima" string="Util. 3 %"/>
                <field name="x_utilidad_4" string="Util. 4 %" optional="hide"/>
                <field name="x_utilidad_5" string="Util. 5 %" optional="hide"/>
                <field name="x_price_usd_1" string="Precio 1 USD" readonly="1"/>
                <field name="x_price_usd_2" string="Precio 2 USD" readonly="1"/>
                <field name="x_price_usd_3" string="Precio 3 USD" readonly="1"/>
                <field name="x_price_usd_4" string="Precio 4 USD" readonly="1" optional="hide"/>
                <field name="x_price_usd_5" string="Precio 5 USD" readonly="1" optional="hide"/>
                <field name="x_price_mxn_1" string="Precio 1 MXN" readonly="1" optional="hide"/>
                <field name="x_price_mxn_2" string="Precio 2 MXN" readonly="1" optional="hide"/>
                <field name="x_price_mxn_3" string="Precio 3 MXN" readonly="1" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_product_template_search_som_cost_editor" model="ir.ui.view">
        <field name="name">product.template.search.som.cost.editor</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Producto"/>
                <field name="default_code" string="Referencia"/>
                <field name="categ_id" string="Categoría"/>
                <filter name="favoritos" string="✓ Revisados"
                        domain="[('x_cost_reviewed', '=', True)]"/>
                <filter name="pendientes" string="Pendientes de revisar"
                        domain="[('x_cost_reviewed', '=', False)]"/>
                <separator/>
                <filter name="group_categ" string="Agrupar por categoría"
                        context="{'group_by': 'categ_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_som_cost_price_editor" model="ir.actions.act_window">
        <field name="name">Costos y Precios</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_product_template_list_som_cost_editor"/>
        <field name="search_view_id" ref="view_product_template_search_som_cost_editor"/>
        <field name="domain">['|', ('type', '!=', 'service'), ('is_storable', '=', True)]</field>
    </record>

    <menuitem id="menu_som_cost_price_editor"
              name="Costos y Precios"
              parent="stock.menu_stock_root"
              action="action_som_cost_price_editor"
              sequence="90"
              groups="product_cost_security.group_product_cost_viewer"/>
</odoo>