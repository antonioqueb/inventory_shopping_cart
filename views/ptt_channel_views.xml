<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sto_ptt_channel_list" model="ir.ui.view">
        <field name="name">sto.ptt.channel.list</field>
        <field name="model">sto.ptt.channel</field>
        <field name="arch" type="xml">
            <list string="Canales de radio">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="room_name"/>
                <field name="is_priority" widget="boolean_toggle"/>
                <field name="member_count"/>
                <field name="online_count"/>
            </list>
        </field>
    </record>

    <record id="view_sto_ptt_channel_form" model="ir.ui.view">
        <field name="name">sto.ptt.channel.form</field>
        <field name="model">sto.ptt.channel</field>
        <field name="arch" type="xml">
            <form string="Canal de radio">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Almacén"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="room_name" placeholder="sto_almacen"/>
                            <field name="is_priority"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="member_count"/>
                            <field name="online_count"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Para qué se usa este canal…"/>
                    <notebook>
                        <page string="Quién escucha" name="listeners">
                            <field name="listener_group_ids" widget="many2many_tags"/>
                            <separator string="Altas puntuales fuera de grupo"/>
                            <field name="member_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Quién habla" name="talkers">
                            <div class="alert alert-info" role="alert">
                                Quien no esté en estos grupos entra al canal en modo
                                <strong>solo escucha</strong>. La restricción la aplica
                                el servidor de voz, no la app.
                            </div>
                            <field name="talker_group_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sto_ptt_channel" model="ir.actions.act_window">
        <field name="name">Canales de radio</field>
        <field name="res_model">sto.ptt.channel</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea el primer canal de radio</p>
            <p>Los canales son las salas del walkie-talkie de la app STO Scanner.
               Cada canal decide quién escucha y quién puede hablar según los
               grupos del ERP.</p>
        </field>
    </record>

    <record id="view_sto_ptt_presence_list" model="ir.ui.view">
        <field name="name">sto.ptt.presence.list</field>
        <field name="model">sto.ptt.presence</field>
        <field name="arch" type="xml">
            <list string="Presencia" create="false" edit="false">
                <field name="user_id"/>
                <field name="channel_id"/>
                <field name="last_seen"/>
            </list>
        </field>
    </record>

    <record id="action_sto_ptt_presence" model="ir.actions.act_window">
        <field name="name">Quién está en línea</field>
        <field name="res_model">sto.ptt.presence</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_sto_ptt_call_list" model="ir.ui.view">
        <field name="name">sto.ptt.call.list</field>
        <field name="model">sto.ptt.call</field>
        <field name="arch" type="xml">
            <list string="Llamadas" create="false" edit="false">
                <field name="create_date" string="Inicio"/>
                <field name="caller_id"/>
                <field name="callee_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-danger="state in ('rejected', 'missed')"/>
                <field name="answered_at" optional="hide"/>
                <field name="ended_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_sto_ptt_call" model="ir.actions.act_window">
        <field name="name">Llamadas</field>
        <field name="res_model">sto.ptt.call</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Menú raíz propio, con icono SVG -->
    <menuitem id="menu_sto_ptt_root"
              name="Radio"
              web_icon="inventory_shopping_cart,static/description/icon_radio.svg"
              sequence="72"
              groups="inventory_shopping_cart.group_ptt_manager"/>

    <menuitem id="menu_sto_ptt_channel"
              name="Canales"
              parent="menu_sto_ptt_root"
              action="action_sto_ptt_channel"
              sequence="10"/>

    <menuitem id="menu_sto_ptt_call"
              name="Llamadas"
              parent="menu_sto_ptt_root"
              action="action_sto_ptt_call"
              sequence="15"/>

    <menuitem id="menu_sto_ptt_presence"
              name="Quién está en línea"
              parent="menu_sto_ptt_root"
              action="action_sto_ptt_presence"
              sequence="20"/>

</odoo>
