<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_som_whatsapp_send_form" model="ir.ui.view">
        <field name="name">som.whatsapp.send.form</field>
        <field name="model">som.whatsapp.send</field>
        <field name="arch" type="xml">
            <form string="Enviar por WhatsApp">
                <group>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="x_report_name" invisible="1"/>
                    <field name="x_filename" invisible="1"/>
                    <field name="x_message" invisible="1"/>
                    <field name="partner_id"/>
                    <field name="report_choice" widget="radio"/>
                </group>
                <div class="text-muted mb-2">
                    Al compartir se abrirá la hoja del sistema: elige WhatsApp
                    y después el contacto — el PDF va adjunto con el mensaje.
                </div>
                <widget name="som_whatsapp_share"/>
                <footer>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Botón en la orden de venta / cotización -->
    <record id="view_order_form_som_whatsapp" model="ir.ui.view">
        <field name="name">sale.order.form.som.whatsapp</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_whatsapp_send" type="object"
                        string="WhatsApp" icon="fa-whatsapp"
                        invisible="state == 'cancel'"/>
            </xpath>
        </field>
    </record>
</odoo>
