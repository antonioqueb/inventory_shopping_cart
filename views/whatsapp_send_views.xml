<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_som_whatsapp_send_form" model="ir.ui.view">
        <field name="name">som.whatsapp.send.form</field>
        <field name="model">som.whatsapp.send</field>
        <field name="arch" type="xml">
            <form string="Enviar por WhatsApp">
                <group>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="partner_id"/>
                    <field name="phone" placeholder="Ej. 8112345678 o +52 81 1234 5678"/>
                    <field name="report_choice" widget="radio"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Abrir WhatsApp"
                            class="btn-success" icon="fa-whatsapp"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Botón en la orden de venta / cotización -->
    <record id="view_order_form_som_whatsapp" model="ir.ui.view">
        <field name="name">sale.order.form.som.whatsapp</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_whatsapp_send" type="object"
                        string="WhatsApp" icon="fa-whatsapp"
                        invisible="state == 'cancel'"/>
            </xpath>
        </field>
    </record>
</odoo>
